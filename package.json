{
  "name": "dsh-voice-anywhere",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "Voice input in any text field: the official microphone, reused as a floating control outside the conversation composer",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "README.md",
    "index.js",
    "host",
    "client.js",
    "build.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "src",
    "scripts",
    "tsconfig.json",
    "types"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "dsh": "^0.2.3-alpha.2",
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "5.9"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/744855705/dsh-voice-anywhere.git"
  },
  "bugs": {
    "url": "https://github.com/744855705/dsh-voice-anywhere/issues"
  },
  "homepage": "https://github.com/744855705/dsh-voice-anywhere#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "voice",
    "speech",
    "dictation",
    "microphone"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/run-tests.mjs",
    "check-build": "node scripts/check-build.mjs",
    "verify": "npm run typecheck && npm test && npm run check-build"
  }
}
